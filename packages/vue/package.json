{
  "name": "@usenavii/vue",
  "version": "0.10.0",
  "description": "Vue 3 binding for Navii deterministic avatars — <Navii seed=\"...\" />.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "avatar",
    "avatars",
    "mascot",
    "svg",
    "vue",
    "deterministic",
    "navii"
  ],
  "license": "MIT",
  "author": "uxderrick",
  "homepage": "https://navii.uxderrick.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxderrick/navii.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/uxderrick/navii/issues",
  "sideEffects": false,
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mhaadi/svg": "^0.5.1",
    "@usenavii/core": "workspace:^0.10.0"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/vue": "^8.1.0",
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
